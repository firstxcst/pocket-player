<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Netflix 风格：固定深色 + 红色强调，不跟随系统动态取色 -->
    <style name="Theme.PocketPlayer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/weg_red</item>
        <item name="colorPrimaryDark">@color/weg_red_dark</item>
        <item name="colorAccent">@color/weg_red</item>
        <item name="colorSecondary">@color/weg_red</item>
        <item name="android:windowBackground">@color/weg_bg</item>
        <item name="android:statusBarColor">@color/weg_bg</item>
        <item name="android:navigationBarColor">@color/weg_bg</item>
        <item name="android:textColorPrimary">@color/weg_text</item>
        <item name="android:textColorSecondary">@color/weg_text_dim</item>
    </style>

    <style name="Theme.PocketPlayer.Player" parent="Theme.PocketPlayer">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <!-- 画面延伸到挖孔区，控制按钮由 DisplayCutout insets 主动避让 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
